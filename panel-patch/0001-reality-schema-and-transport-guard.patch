+    /**
+     * 把面板里的 reality_settings 归一成节点后端消费的形状。
+     *
+     * 为什么要单独一步：DB 里存的是 snake_case（short_id / mldsa65_seed / min_client_ver），
+     * 而 Xray-core 的 REALITY 配置是 camelCase（shortIds / mldsa65Seed / minClientVer）。
+     * 以前直接整对象透传，导致后端只能改名猜字段。
+     *
+     * 关键约定：minClientVer / maxClientVer 默认是 null（= 不限制）。
+     * 一旦下发 26.x，所有自报 1.8.2 的 mihomo 系客户端（Clash Verge Rev / FlClash /
+     * OpenWrt-nikki）都会被 REALITY 静默回落成"连普通 TLS 站"，现象是握手失败而非报错。
+     */
+    private static function realityConfig(array $protocolSettings): array
+    {
+        $reality = data_get($protocolSettings, 'reality_settings') ?? [];
+        if (! is_array($reality)) {
+            $reality = [];
+        }
+
+        return [
+            'show' => false,
+            'dest' => $reality['dest'] ?? null,
+            'server_name' => $reality['server_name'] ?? null,
+            'server_names' => $reality['server_names'] ?? null,
+            'server_port' => $reality['server_port'] ?? null,
+            'public_key' => $reality['public_key'] ?? null,
+            'private_key' => $reality['private_key'] ?? null,
+            'short_id' => $reality['short_id'] ?? null,
+            'short_ids' => $reality['short_ids'] ?? null,
+            'mldsa65Seed' => $reality['mldsa65_seed'] ?? null,
+            'xver' => (string) (int) ($reality['xver'] ?? 0),
+            'maxTimeDiff' => $reality['max_time_diff'] ?? null,
+            'minClientVer' => $reality['min_client_ver'] ?? null,
+            'maxClientVer' => $reality['max_client_ver'] ?? null,
+        ];
+    }
+
