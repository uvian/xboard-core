+++ b/app/usergate/usergate.go
@@ -0,0 +1,312 @@
+// Package usergate 是节点后端注入「设备数 + 每用户限速」的唯一挂载点。
+//
+// 为什么这样挂：Xboard-Node 用 //go:linkname 劫持 common.typeCreatorRegistry
+// 替换整个 dispatcher 工厂，v2node 把 700 行 dispatcher 复制进自己的模块。
+// 两条路都能跑，但一条依赖未导出符号、一条要人工同步上游改动。
+// 这里只在上游 dispatcher 的两条数据面路径上各插一次 Admit + Limit，
+// 闸门状态全部留在节点进程里，xray 本身不持有任何面板数据。
+//
+// 不变量：
+//   - 没有 Install（gate == nil）时，本包的所有函数都是廉价 no-op，
+//     所以 vendored xray 单独跑（例如 go test ./app/dispatcher/...）行为不变；
+//   - 限速在字节层生效，桶按 tag|email|方向 隔离，一个用户的慢速不会波及别人。
+package usergate
+
+import (
+	"context"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/transport"
+)
+
+// Gate 由节点进程实现并注入。两个方法都必须是并发安全的。
+type Gate interface {
+	// Admit 决定这条连接是否放行；返回 error 即拒绝（连接被关闭）。
+	// email 与 xray 的 protocol.User.Email 一致，ip 是客户端源地址。
+	Admit(ctx context.Context, tag, email, ip string) error
+	// Rate 返回该用户当前的字节/秒上限，<= 0 表示不限速。
+	Rate(tag, email string) int64
+}
+
+var (
+	current atomic.Pointer[gateBox]
+)
+
+type gateBox struct{ g Gate }
+
+// Install 注入闸门实现。传 nil 即卸载（测试与 standalone 模式用）。
+func Install(g Gate) {
+	if g == nil {
+		current.Store(nil)
+		return
+	}
+	current.Store(&gateBox{g: g})
+}
+
+func gate() Gate {
+	if b := current.Load(); b != nil {
+		return b.g
+	}
+	return nil
+}
+
+// Identity 描述一次连接归谁。
+type Identity struct {
+	Tag   string
+	Email string
+	IP    string
+}
+
+func identify(ctx context.Context) Identity {
+	inbound := session.InboundFromContext(ctx)
+	if inbound == nil {
+		return Identity{}
+	}
+	id := Identity{Tag: inbound.Tag}
+	if inbound.User != nil {
+		id.Email = inbound.User.Email
+	}
+	if inbound.Source.Address != nil {
+		if ip := inbound.Source.Address.IP(); ip != nil {
+			id.IP = ip.String()
+		}
+	}
+	return id
+}
+
+// Admit 是数据面入口的第一道闸。返回 error 时调用方必须关闭链路并退出。
+func Admit(ctx context.Context) error {
+	g := gate()
+	if g == nil {
+		return nil
+	}
+	id := identify(ctx)
+	if id.Email == "" {
+		// 匿名协议（socks/http 无账号）没有身份可比，只能放行——这是设计约束，
+		// 不是疏忽：要卡这类入站得在入站层做认证。副作用是 vless 的 fallbacks
+		// 转发进来的连接不带 email，也会走到这里；启用 fallbacks 前请确认这个语义可接受。
+		return nil
+	}
+	return g.Admit(ctx, id.Tag, id.Email, id.IP)
+}
+
+// Close 关闭链路两端。闸门拒绝后必须调用，否则 getLink 刚建的四条 pipe 会泄漏。
+//
+// 注意 buf.Reader / buf.Writer 接口本身没有 Close，只有 pipe 的具体类型有，
+// 所以这里用可选接口断言——非 pipe 实现（例如 udp 复用链路）静默跳过。
+func Close(l *transport.Link) {
+	if l == nil {
+		return
+	}
+	if c, ok := l.Reader.(interface{ Close() error }); ok {
+		_ = c.Close()
+	}
+	if c, ok := l.Writer.(interface{ Close() error }); ok {
+		_ = c.Close()
+	}
+}
+
+// Limit 给链路的上下行各套一个令牌桶。没有闸门或用户不限速时原样返回。
+func Limit(ctx context.Context, link *transport.Link) {
+	g := gate()
+	if g == nil || link == nil {
+		return
+	}
+	id := identify(ctx)
+	if id.Email == "" {
+		return
+	}
+	rate := g.Rate(id.Tag, id.Email)
+	if rate <= 0 {
+		return
+	}
+	key := id.Tag + "|" + id.Email
+	if link.Writer != nil {
+		link.Writer = &rateWriter{writer: link.Writer, b: bucketFor(key+"|up", rate)}
+	}
+	if link.Reader != nil {
+		link.Reader = &rateReader{reader: link.Reader, b: bucketFor(key+"|down", rate)}
+	}
+}
+
+// ---------------------------------------------------------------- 令牌桶
+
+type bucket struct {
+	mu     sync.Mutex
+	rate   float64 // bytes per second
+	tokens float64
+	burst  float64
+	last   time.Time
+}
+
+const (
+	// 桶容量基线：允许 1 秒的量突发，太小会把正常交互打成碎片。
+	minBurst = 8 * 1024
+	maxBurst = 4 * 1024 * 1024
+)
+
+func newBucket(rate int64) *bucket {
+	r := float64(rate)
+	burst := r
+	if burst < minBurst {
+		burst = minBurst
+	}
+	if burst > maxBurst {
+		burst = maxBurst
+	}
+	return &bucket{rate: r, tokens: burst, burst: burst, last: time.Now()}
+}
+
+func (b *bucket) refill() {
+	now := time.Now()
+	if d := now.Sub(b.last).Seconds(); d > 0 {
+		b.tokens += d * b.rate
+		if b.tokens > b.burst {
+			b.tokens = b.burst
+		}
+		b.last = now
+	}
+}
+
+// wait 取 n 个令牌，不够就按速率等，等到 ctx 结束为止。
+// 注意：这里刻意用「等」而不是「丢」，限速的目标是降速，不是断流。
+func (b *bucket) wait(ctx context.Context, n int64) error {
+	if n <= 0 {
+		return nil
+	}
+	for {
+		b.mu.Lock()
+		b.refill()
+		if b.tokens >= float64(n) {
+			b.tokens -= float64(n)
+			b.mu.Unlock()
+			return nil
+		}
+		deficit := float64(n) - b.tokens
+		wait := time.Duration(deficit / b.rate * float64(time.Second))
+		if wait < time.Millisecond {
+			wait = time.Millisecond
+		}
+		b.mu.Unlock()
+
+		t := time.NewTimer(wait)
+		select {
+		case <-ctx.Done():
+			t.Stop()
+			return ctx.Err()
+		case <-t.C:
+		}
+	}
+}
+
+var (
+	bucketsMu sync.Mutex
+	buckets   = make(map[string]*bucket)
+	lastSweep atomic.Int64
+)
+
+// bucketFor 按 key 取桶；用户被限速值改动时节点会换 key（见 gate 侧实现），
+// 这里额外做一次粗暴清理，避免长期运行后 map 无限增长。
+func bucketFor(key string, rate int64) *bucket {
+	bucketsMu.Lock()
+	defer bucketsMu.Unlock()
+	// 清扫放在命中判断之前：否则老用户一直在线（命中路径提前 return）时桶永远不回收。
+	sweepLocked()
+	if b, ok := buckets[key]; ok && int64(b.rate) == rate {
+		return b
+	}
+	b := newBucket(rate)
+	buckets[key] = b
+	return b
+}
+
+// sweepLocked 每 10 分钟回收一次空闲桶。调用方必须持有 bucketsMu。
+// 上界是「最近 10 分钟活跃过的用户数 × 2（上下行）」，不会随历史用户数增长。
+func sweepLocked() {
+	now := time.Now().Unix()
+	if now-lastSweep.Load() <= 600 {
+		return
+	}
+	lastSweep.Store(now)
+	for k, v := range buckets {
+		v.mu.Lock()
+		idle := time.Since(v.last) > 10*time.Minute
+		v.mu.Unlock()
+		if idle {
+			delete(buckets, k)
+		}
+	}
+}
+
+// Forget 立即释放某用户的所有桶（用户被删除/限速归零时调用；即使不调用，
+// sweepLocked 也会在 10 分钟内回收，这里只是为了立刻生效）。
+func Forget(tag, email string) {
+	prefix := tag + "|" + email + "|"
+	bucketsMu.Lock()
+	for k := range buckets {
+		if strings.HasPrefix(k, prefix) {
+			delete(buckets, k)
+		}
+	}
+	bucketsMu.Unlock()
+}
+
+// ---------------------------------------------------------------- 链路包装
+
+type rateWriter struct {
+	writer buf.Writer
+	b      *bucket
+}
+
+func (w *rateWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	if mb.IsEmpty() {
+		return w.writer.WriteMultiBuffer(mb)
+	}
+	if err := w.b.wait(context.Background(), int64(mb.Len())); err != nil {
+		buf.ReleaseMulti(mb)
+		return errors.New("usergate: rate limit: ").Base(err)
+	}
+	return w.writer.WriteMultiBuffer(mb)
+}
+
+type rateReader struct {
+	reader buf.Reader
+	b      *bucket
+}
+
+// ReadMultiBufferTimeout 保留 buf.TimeoutReader 能力。
+//
+// 必须实现：dispatcher 的 DispatchLink 在 sniffing 开启时会把 outbound.Reader
+// 断言成 buf.TimeoutReader，包装后丢掉这个接口会直接 panic。
+func (r *rateReader) ReadMultiBufferTimeout(d time.Duration) (buf.MultiBuffer, error) {
+	if tr, ok := r.reader.(buf.TimeoutReader); ok {
+		mb, err := tr.ReadMultiBufferTimeout(d)
+		if err != nil || mb.IsEmpty() {
+			return mb, err
+		}
+		if werr := r.b.wait(context.Background(), int64(mb.Len())); werr != nil {
+			buf.ReleaseMulti(mb)
+			return nil, errors.New("usergate: rate limit: ").Base(werr)
+		}
+		return mb, nil
+	}
+	return r.ReadMultiBuffer()
+}
+
+func (r *rateReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	mb, err := r.reader.ReadMultiBuffer()
+	if err != nil || mb.IsEmpty() {
+		return mb, err
+	}
+	if werr := r.b.wait(context.Background(), int64(mb.Len())); werr != nil {
+		buf.ReleaseMulti(mb)
+		return nil, errors.New("usergate: rate limit: ").Base(werr)
+	}
+	return mb, nil
+}
