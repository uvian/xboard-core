@@ -0,0 +1,89 @@
+package usergate
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/transport"
+)
+
+func TestNoGateIsNoop(t *testing.T) {
+	Install(nil)
+	if err := Admit(context.Background()); err != nil {
+		t.Fatalf("Admit without gate: %v", err)
+	}
+	link := &transport.Link{Reader: &fakeReader{}, Writer: &fakeWriter{}}
+	Limit(context.Background(), link)
+	if _, ok := link.Writer.(*rateWriter); ok {
+		t.Fatal("Limit wrapped writer without a gate installed")
+	}
+}
+
+type fakeWriter struct{ n int }
+
+func (w *fakeWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	w.n += int(mb.Len())
+	buf.ReleaseMulti(mb)
+	return nil
+}
+
+type fakeReader struct{}
+
+func (r *fakeReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	mb := buf.MultiBuffer{buf.New()}
+	mb[0].Write([]byte("ping"))
+	return mb, nil
+}
+
+type fakeGate struct {
+	reject bool
+	rate   int64
+	seen   Identity
+}
+
+func (g *fakeGate) Admit(_ context.Context, tag, email, ip string) error {
+	g.seen = Identity{Tag: tag, Email: email, IP: ip}
+	if g.reject {
+		return context.Canceled
+	}
+	return nil
+}
+
+func (g *fakeGate) Rate(string, string) int64 { return g.rate }
+
+// 桶必须真的限速：8KB/s 的桶写 32KB，至少要花 3 秒（允许 1 秒突发）。
+func TestBucketThrottles(t *testing.T) {
+	b := newBucket(8 * 1024)
+	start := time.Now()
+	for i := 0; i < 4; i++ {
+		if err := b.wait(context.Background(), 8*1024); err != nil {
+			t.Fatalf("wait: %v", err)
+		}
+	}
+	if elapsed := time.Since(start); elapsed < 2*time.Second {
+		t.Fatalf("bucket did not throttle: %v", elapsed)
+	}
+}
+
+// ctx 结束必须立刻返回，否则节点停机时会被限速等待拖住。
+func TestBucketRespectsContext(t *testing.T) {
+	b := newBucket(1024)
+	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer cancel()
+	if err := b.wait(ctx, 1024*1024); err == nil {
+		t.Fatal("expected context error")
+	}
+}
+
+func TestForgetDropsBuckets(t *testing.T) {
+	bucketFor("n1|a@b|c|up", 1024)
+	Forget("n1", "a@b")
+	bucketsMu.Lock()
+	n := len(buckets)
+	bucketsMu.Unlock()
+	if n != 0 {
+		t.Fatalf("buckets not released: %d", n)
+	}
+}
